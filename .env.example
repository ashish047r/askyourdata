# Copy to .env (never commit .env). The same keys go into Render env vars and GitHub secrets.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon: owner role (Django, migrations, sync)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Neon: read-only role for LLM-generated SQL (created by migration data/0002 from these credentials).
# Use a long random password; same host and database as above.
DATABASE_URL_RO=postgresql://askdata_ro:LONG_RANDOM_PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# OpenAI (your own key; set a monthly usage limit in the OpenAI dashboard)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low

# Google (python manage.py google_login path/to/client_secret.json prints these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Same version string your my-google-ads-mcp server.py uses, e.g. vNN
GOOGLE_ADS_API_VERSION=

# Limits (change without a deploy)
DAILY_COST_CAP_USD=0.50
ASK_RATE=60/hour
SEMANTIC_CACHE_MAX_DISTANCE=0.08

# Langfuse tracing (optional; leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
