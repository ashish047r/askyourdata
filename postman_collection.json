{
  "info": {
    "name": "AskYourData",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run '0 Auth > Get token' first. client_id: from 'My clients'."
  },
  "item": [
    {
      "name": "0 Auth",
      "item": [
        {
          "name": "Get token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "description": "Saves the token into the collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 App API",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "My clients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/clients/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Ask (fresh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ask/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "description": "First call: meta.cache_hit is empty.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": {{client_id}},\n  \"question\": \"Top 5 campaigns by conversions last month\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.query_id) pm.collectionVariables.set('query_id', j.query_id);",
                  "pm.test('has status', () => pm.expect(j.status).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask again (exact cache)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ask/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "description": "Same question: meta.cache_hit = exact, cost 0.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": {{client_id}},\n  \"question\": \"Top 5 campaigns by conversions last month\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.query_id) pm.collectionVariables.set('query_id', j.query_id);",
                  "pm.test('has status', () => pm.expect(j.status).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask paraphrase (semantic cache)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ask/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "description": "Paraphrase: may hit the semantic cache.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": {{client_id}},\n  \"question\": \"Which 5 campaigns got the most conversions last month?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.query_id) pm.collectionVariables.set('query_id', j.query_id);",
                  "pm.test('has status', () => pm.expect(j.status).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask different window (must miss cache)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ask/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ask"
              ]
            },
            "description": "Constraint guard: different date range never reuses an answer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": {{client_id}},\n  \"question\": \"Top 5 campaigns by conversions in the last 7 days\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.query_id) pm.collectionVariables.set('query_id', j.query_id);",
                  "pm.test('has status', () => pm.expect(j.status).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ask ambiguous (clarify)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
